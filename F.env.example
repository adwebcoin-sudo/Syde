# =========================================================
# انسخ هذا الملف باسم .env واملأ القيم الحقيقية
# لا ترفع ملف .env نفسه لأي مكان عام (GitHub مثلاً)
# =========================================================

# التوكن اللي جبته من app.metaapi.cloud/token
METAAPI_TOKEN=ضع_التوكن_هنا

# معرّف حساب MT5 "الماستر" (الروبوت) بعد إضافته على app.metaapi.cloud/accounts
MASTER_ACCOUNT_ID=ضع_معرف_حساب_الماستر_هنا

# اسم إستراتيجية CopyFactory (يُنشأ تلقائيًا أول مرة تشغّل السيرفر)
STRATEGY_NAME=Nabd SMA Strategy

# منفذ التشغيل (Render بيحدده تلقائيًا عادة عبر PORT)
PORT=3000
